<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Register a student for a department." />
    <title>Student Registration | Cognifyz</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="page-shell">
      <section class="card" aria-labelledby="page-title">
        <div class="eyebrow">COGNIFYZ · INTERNSHIP TASK 1</div>
        <h1 id="page-title">Student registration</h1>
        <p class="intro">Complete the form below to register a student.</p>

        <% if (errors.length > 0) { %>
          <div class="alert" role="alert" aria-labelledby="error-heading">
            <h2 id="error-heading">Please check the following:</h2>
            <ul>
              <% errors.forEach((error) => { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <form action="/register" method="POST">
          <div class="form-field">
            <label for="name">Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="e.g. Alex Morgan"
              value="<%= values.name %>"
              required
            />
          </div>

          <div class="form-field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              value="<%= values.email %>"
              required
            />
          </div>

          <div class="form-field">
            <label for="department">Department</label>
            <select id="department" name="department" required>
              <option value="" disabled <%= values.department ? "" : "selected" %>>Choose a department</option>
              <% departments.forEach((department) => { %>
                <option value="<%= department %>" <%= values.department === department ? "selected" : "" %>>
                  <%= department %>
                </option>
              <% }); %>
            </select>
          </div>

          <button class="button" type="submit">Register student <span aria-hidden="true">→</span></button>
        </form>
        <p class="privacy-note">Your information is only shown on the result page for this demo.</p>
      </section>
      <footer>Built with Node.js, Express, and EJS</footer>
    </main>
  </body>
</html>
